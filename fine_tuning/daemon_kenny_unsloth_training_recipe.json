    "edges": [
      {
        "from": "teacher_provider",
        "to": "teacher_model",
        "type": "semantic",
        "source_handle": "semantic-out-bottom",
        "target_handle": "semantic-in-top"
      },
      {
        "from": "mode",
        "to": "scenario_context",
        "type": "canvas",
        "source_handle": "data-out",
        "target_handle": "data-in"
      },
      {
        "from": "activity_level",
        "to": "scenario_context",
        "type": "canvas",
